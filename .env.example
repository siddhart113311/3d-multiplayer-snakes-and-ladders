# Copy this file to `.env` and adjust for your environment.
# `.env` is git-ignored — never commit real credentials.

# PostgreSQL connection string used by Drizzle ORM (src/db/index.ts)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Pusher Channels (optional for real-time WebSockets, falls back to polling if absent)
PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_KEY=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_CLUSTER=ap2

# LiveKit WebRTC Voice Chat (optional, enables low-latency voice chat)
LIVEKIT_URL=wss://your-subdomain.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=wss://your-subdomain.livekit.cloud
